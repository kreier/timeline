# Translation & AI Model API Keys (used by db/auto-translate.py)
# Copy this file to .env and populate keys as needed.

# DeepL API Key (for the 'deepl' translation column)
DEEPL_API_KEY=

# OpenRouter API Key (for ChatGPT / open-source model suggestions)
OPENROUTER_API_KEY=
# Optional: Model override for OpenRouter (default: minimax/minimax-m3:free)
# OPENROUTER_CHATGPT_MODEL=minimax/minimax-m3:free

# Google Gemini API Key (for the 'gemini' translation column)
GEMINI_API_KEY=

# Anthropic Claude API Key (for the 'claude' translation column)
ANTHROPIC_API_KEY=
